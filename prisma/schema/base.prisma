enum UserRole {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  PATIENT
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  DELETED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AuditAction {
  USER_REGISTERED
  EMAIL_VERIFIED
  VERIFICATION_EMAIL_RESENT
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  ACCOUNT_LOCKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  LOGOUT
  LOGOUT_ALL
  SESSION_REVOKED
  SESSION_AUTO_REVOKED
  ADMIN_CREATED
  ADMIN_PROFILE_UPDATED
  ADMIN_ROLE_CHANGED
  ADMIN_STATUS_CHANGED
  ADMIN_LIST_VIEWED
  DOCTOR_CREATED
  DOCTOR_PROFILE_UPDATED
  DOCTOR_DELETED
  SPECIALTY_CREATED
  SPECIALTY_UPDATED
  SPECIALTY_DELETED
}

model User {
  id String @id @default(uuid(7))

  name          String  @db.VarChar(100)
  email         String  @unique @db.VarChar(320)
  emailVerified Boolean @default(false)
  image         String? @db.VarChar(2048)

  role               UserRole   @default(PATIENT)
  status             UserStatus @default(PENDING)
  needPasswordChange Boolean    @default(false)

  lastLoginAt                DateTime?
  failedLoginAttempts        Int       @default(0)
  failedLoginWindowStartedAt DateTime?
  lockedAt                   DateTime?
  deletedAt                  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient         Patient?
  admin           Admin?
  doctor          Doctor?
  sessions        Session[]
  accounts        Account[]
  authTokens      AuthToken[]
  passwordHistory PasswordHistory[]
  loginAttempts   LoginAttempt[]
  auditLogs       AuditLog[]

  @@index([role, status], name: "idx_user_role_status")
  @@index([status], name: "idx_user_status")
  @@map("users")
}

model Session {
  id String @id @default(uuid(7))

  expiresAt      DateTime
  token          String   @unique @db.VarChar(255)
  ipAddress      String?  @db.VarChar(64)
  userAgent      String?  @db.Text
  lastActivityAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId], name: "idx_session_userId")
  @@index([expiresAt], name: "idx_session_expiresAt")
  @@map("sessions")
}

model Account {
  id String @id @default(uuid(7))

  issuer                String    @db.VarChar(255)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(100)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.VarChar(255)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([issuer, accountId], name: "account_issuer_accountId_key")
  @@index([userId], name: "idx_account_userId")
  @@map("accounts")
}

model Verification {
  id String @id @default(uuid(7))

  identifier String   @db.VarChar(320)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier], name: "idx_verification_identifier")
  @@map("verifications")
}

model AuthToken {
  id String @id @default(uuid(7))

  type      AuthTokenType
  tokenHash String        @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, type, createdAt], name: "idx_auth_token_user_type_created")
  @@index([expiresAt], name: "idx_auth_token_expiresAt")
  @@map("auth_tokens")
}

model PasswordHistory {
  id String @id @default(uuid(7))

  passwordHash String   @db.VarChar(255)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)], name: "idx_password_history_user_created")
  @@map("password_history")
}

model LoginAttempt {
  id String @id @default(uuid(7))

  email     String   @db.VarChar(320)
  userId    String?
  succeeded Boolean  @default(false)
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt], name: "idx_login_attempt_email_created")
  @@index([userId, createdAt], name: "idx_login_attempt_user_created")
  @@map("login_attempts")
}

model AuditLog {
  id String @id @default(uuid(7))

  action    AuditAction
  userId    String?
  ipAddress String?     @db.VarChar(64)
  userAgent String?     @db.Text
  metadata  Json?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], name: "idx_audit_log_user_created")
  @@index([action, createdAt], name: "idx_audit_log_action_created")
  @@map("audit_logs")
}
