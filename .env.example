NODE_ENV=development
HOST=0.0.0.0
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ph_healthcare

# Comma-separated browser origins. Use explicit origins outside local development.
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000

APP_BASE_URL=http://localhost:5000
CLIENT_BASE_URL=http://localhost:3000
# Generate independent secrets with at least 32 random bytes for real environments.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
BCRYPT_ROUNDS=12
EMAIL_FROM=no-reply@ph-healthcare.local

# Private S3-compatible medical document storage. IAM/default credentials may be used
# by leaving the explicit credentials unset.
S3_REGION=us-east-1
S3_BUCKET=ph-healthcare-private
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Production uploads require an external antivirus service returning { "safe": boolean }.
# VIRUS_SCAN_URL=https://scanner.internal.example/scan
# VIRUS_SCAN_API_KEY=

# IANA timezone used for schedule date validation and default date ranges.
SCHEDULE_TIME_ZONE=UTC

# Stripe hosted checkout and signed webhooks. Required in production.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=usd
PAYMENT_SUCCESS_URL=http://localhost:3000/payments/success?session_id={CHECKOUT_SESSION_ID}
PAYMENT_CANCEL_URL=http://localhost:3000/payments/cancelled

# Invoice identity and optional tax rate (basis points; 1000 = 10%).
INVOICE_COMPANY_NAME=PH HealthCare
INVOICE_COMPANY_ADDRESS=Healthcare Services
INVOICE_COMPANY_PHONE=
INVOICE_COMPANY_EMAIL=
INVOICE_TAX_ID=
INVOICE_TAX_RATE_BPS=0
INVOICE_CURRENCY_SYMBOL=$

# Required only when running `pnpm run seed`.
SEED_SUPER_ADMIN_NAME=System Super Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
