NODE_ENV=development
HOST=0.0.0.0
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ph_healthcare

# Comma-separated browser origins. Use explicit origins outside local development.
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000

APP_BASE_URL=http://localhost:5000
CLIENT_BASE_URL=http://localhost:3000
# Generate independent secrets with at least 32 random bytes for real environments.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
BCRYPT_ROUNDS=12
EMAIL_FROM=no-reply@ph-healthcare.local

# Required only when running `pnpm run seed`.
SEED_SUPER_ADMIN_NAME=System Super Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
